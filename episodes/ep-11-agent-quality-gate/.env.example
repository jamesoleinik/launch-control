# Select this episode's environment from scripts/auth.py.
LC_ENV=ep-11-agent-quality-gate

# Dataverse environment. Never commit real values.
DATAVERSE_URL=https://<environment>.crm.dynamics.com
TENANT_ID=<tenant-id>

# Microsoft Entra Agent ID and Agent 365 registration.
A365_BLUEPRINT_CLIENT_ID=<blueprint-client-id>
A365_BLUEPRINT_CLIENT_SECRET=<blueprint-client-secret>
A365_AGENT_ID=<agent-identity-client-id>
A365_AGENT_USER_ID=<agent-user-object-id>

# Optional Microsoft 365 resource. Required only for mailbox notifications.
A365_AGENT_MAILBOX=<agent-mailbox-address>

# Optional Agentic User-authored Teams completion update.
A365_TEAMS_RECIPIENT=<recipient-user-principal-name>
LAUNCH_CONTROL_APP_ID=<model-driven-app-id>

# Optional approved Microsoft Entra Agent ID token broker or Auth SDK sidecar
# adapter. When omitted, the worker can use the documented direct Agent User
# OAuth flow for a controlled test with the short-lived blueprint secret above.
A365_TOKEN_BROKER_URL=http://127.0.0.1:<port>/token

# Dataverse system user created for the Entra Agentic User.
QUALITY_GATE_AGENT_SYSTEMUSER_ID=<dataverse-systemuser-id>

# Local quality check.
QUALITY_GATE_URL=http://127.0.0.1:8000
QUALITY_GATE_REQUIRED_TEXT=Launch Control
QUALITY_GATE_POLL_SECONDS=300
QUALITY_GATE_HEADLESS=true
QUALITY_GATE_DEMO_MODE=false
QUALITY_GATE_DEMO_STEP_SECONDS=1.2
QUALITY_GATE_DEMO_HOLD_SECONDS=8
QUALITY_GATE_EVIDENCE_DIR=.artifacts/quality-gate
# Local recording fallback only. Uses Azure CLI plus MSCRMCallerID to exercise
# the Agentic User role and attribution when Agent User OAuth is unavailable.
QUALITY_GATE_IMPERSONATE_AGENT=false
