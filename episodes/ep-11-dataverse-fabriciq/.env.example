# Ep 11 - Dataverse + Fabric IQ
# Copy to ".env" in this folder (gitignored) and fill in your own values.
# Select it from any script with:  LC_ENV=ep-11-dataverse-fabriciq

DATAVERSE_URL=https://<your-dataverse-env>.crm.dynamics.com

# Fabric workspace that holds the Fabric IQ ontology (over Dataverse-linked data).
# The Copilot Studio "Fabric IQ Ontology" MCP needs the Workspace ID + Ontology ID.
FABRIC_WORKSPACE_ID=<your-fabric-workspace-id>
FABRIC_ONTOLOGY_ID=<your-fabric-ontology-id>
POWERBI_WORKSPACE=powerbi://api.powerbi.com/v1.0/myorg/<your-workspace>

TENANT_ID=<your-tenant-id>
