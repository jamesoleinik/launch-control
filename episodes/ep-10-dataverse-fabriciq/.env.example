# Ep 10 - Dataverse + Fabric (Direct Lake analytical layer)
# Copy to ".env" in this folder (gitignored) and fill in your own values.
# Select it from any script with:  LC_ENV=ep-10-dataverse-fabriciq

DATAVERSE_URL=https://<your-dataverse-env>.crm.dynamics.com
TENANT_ID=<your-tenant-id>

# Fabric workspace (LaunchControl) - contains the Dataverse Fabric Link lakehouse.
FABRIC_WORKSPACE_ID=<your-fabric-workspace-id>
FABRIC_WORKSPACE_NAME=LaunchControl
POWERBI_WORKSPACE=powerbi://api.powerbi.com/v1.0/myorg/LaunchControl

# Lakehouse created by the Dataverse Fabric Link (auto-named after the Dataverse env)
FABRIC_LAKEHOUSE_ID=<your-lakehouse-id>
FABRIC_LAKEHOUSE_NAME=dataverse_<your-env-unique-name>
