# Ep 11 - Dataverse + Web IQ
# Copy to ".env" in this folder (gitignored) and fill in your own values.
# Select it from any script with:  LC_ENV=ep-11-dataverse-webiq

DATAVERSE_URL=https://<your-dataverse-env>.crm.dynamics.com

# Web IQ MCP endpoint and key (request the key from your Microsoft representative;
# never commit a real key). See https://www.microsoft.com/webiq.
WEBIQ_MCP_URL=https://api.microsoft.ai/v3/mcp
WEBIQ_API_KEY=<your-webiq-api-key>

TENANT_ID=<your-tenant-id>
