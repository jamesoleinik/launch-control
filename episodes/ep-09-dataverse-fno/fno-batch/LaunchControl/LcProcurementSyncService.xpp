/// <summary>
/// Server-side body of the Launch Control procurement sync batch job.
///
/// This is the native Finance and Operations equivalent of the external digest
/// in batch_launch_sync.py. Running inside the F&O batch server, it reads the
/// purchase-order data directly (PurchTable / PurchLine), rolls the open
/// commitment up per vendor, and writes the result to the batch job log. It runs
/// under System administration &gt; Inquiries &gt; Batch jobs, so each run appears in
/// Batch job history.
///
/// The launch-code join (which launch each engagement belongs to) is completed
/// on the Dataverse side in lc_vendorwork. This batch owns the procurement side:
/// committed, invoiced and outstanding per vendor, sourced from F&O.
/// </summary>
class LcProcurementSyncService extends SysOperationServiceBase
{
    /// <summary>
    /// Entry point invoked by the SysOperation framework (and therefore by the
    /// batch server). Aggregates open purchase-order commitment per vendor and
    /// logs a digest line for each, flagging any that exceed the threshold.
    /// </summary>
    /// <param name = "_contract">The parameters captured in the batch dialog.</param>
    public void run(LcProcurementSyncContract _contract)
    {
        PurchTable  purchTable;
        PurchLine   purchLine;
        real        threshold = _contract.parmOutstandingThreshold()
                        ? _contract.parmOutstandingThreshold()
                        : 50000;
        str         company   = _contract.parmDataAreaId()
                        ? _contract.parmDataAreaId()
                        : curExt();

        int         vendorCount;
        int         atRiskCount;
        real        grandCommitted;

        info(strFmt("Launch Control procurement sync starting (company: %1, threshold: %2).",
                    company, threshold));

        // One row per vendor: committed is the summed ordered line amount across
        // that vendor's non-canceled purchase orders. An open purchase-order line
        // is outstanding commitment, so we report it directly. Invoice
        // reconciliation (subtracting the already-invoiced portion from VendTrans
        // / VendInvoiceJour) is a documented extension: see README.md.
        //
        // changecompany scopes the whole scan to the requested legal entity so
        // the job is safe to run from any company context.
        changecompany (company)
        {
            while select OrderAccount from purchTable
                group by purchTable.OrderAccount
                where purchTable.PurchStatus != PurchStatus::Canceled
                join sum(LineAmount) from purchLine
                    where purchLine.PurchId == purchTable.PurchId
            {
                if (!purchTable.OrderAccount)
                {
                    continue;
                }

                real committed = purchLine.LineAmount;

                vendorCount++;
                grandCommitted += committed;

                boolean atRisk = committed > threshold;
                if (atRisk)
                {
                    atRiskCount++;
                }

                info(strFmt("  vendor %1 | committed %2 | outstanding %2 | %3",
                            purchTable.OrderAccount,
                            committed,
                            atRisk ? "AT-RISK" : "OK"));
            }
        }

        info(strFmt("Launch Control procurement sync complete: %1 vendors, %2 at risk, committed %3.",
                    vendorCount,
                    atRiskCount,
                    grandCommitted));
    }
}
