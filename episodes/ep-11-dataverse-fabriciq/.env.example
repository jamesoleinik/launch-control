# Ep 11 - Dataverse + Fabric Operations Agent (two-plane architecture)
# Copy to ".env" in this folder (gitignored) and fill in your own values.
# Select it from any script with:  LC_ENV=ep-11-dataverse-fabriciq

DATAVERSE_URL=https://<your-dataverse-env>.crm.dynamics.com
TENANT_ID=<your-tenant-id>

# Fabric workspace (LaunchControl) - contains the Dataverse Fabric Link lakehouse
# and the LaunchControlEH eventhouse used by the Operations Agent.
FABRIC_WORKSPACE_ID=<your-fabric-workspace-id>
FABRIC_WORKSPACE_NAME=LaunchControl
POWERBI_WORKSPACE=powerbi://api.powerbi.com/v1.0/myorg/LaunchControl

# Lakehouse created by the Dataverse Fabric Link (auto-named after the Dataverse env)
FABRIC_LAKEHOUSE_ID=<your-lakehouse-id>
FABRIC_LAKEHOUSE_NAME=dataverse_<your-env-unique-name>

# Eventhouse + KQL database (created by setup_eventhouse.py)
FABRIC_EVENTHOUSE_ID=<your-eventhouse-id>
FABRIC_KQL_DATABASE_ID=<your-kql-database-id>
FABRIC_KQL_DATABASE_NAME=LaunchControlEH
FABRIC_KQL_CLUSTER_URI=https://trd-<hash>.z<n>.kusto.fabric.microsoft.com
FABRIC_KQL_INGEST_URI=https://ingest-trd-<hash>.z<n>.kusto.fabric.microsoft.com

# Operations Agent (created by setup_operations_agent.py - requires one portal step first)
FABRIC_OPS_AGENT_ID=<your-operations-agent-id>
