# Ep 9 - Dataverse + F&O (CRM + ERP)
# Copy to ".env" in this folder (gitignored) and fill in your own values.
# Select it from any script with:  LC_ENV=ep-09-dataverse-fno
# (PowerShell: $env:LC_ENV = "ep-09-dataverse-fno")

# Dataverse side of the F&O-linked environment (where lc_ launch tables live
# and where F&O virtual entities / dual-write tables surface).
DATAVERSE_URL=https://<your-fno-env>.crm.dynamics.com

# Finance & Operations OData base (used by assign_fno_role.py and ERP calls).
FNO_URL=https://<your-fno-env>.operations.dynamics.com

TENANT_ID=<your-tenant-id>
