/// <summary>
/// Runnable, batch-enabled entry point for the Launch Control procurement sync.
///
/// Because it derives from SysOperationServiceController, F&O renders a batch
/// dialog with the standard "Run in the background" (Batch) tab. From there an
/// operator can set a recurrence and batch group, and every execution shows up
/// under System administration &gt; Inquiries &gt; Batch jobs (Batch job history).
///
/// Attach an "Output menu item" (action menu item pointing at this class) to a
/// menu so it is launchable from the F&O client, or schedule it directly.
/// </summary>
class LcProcurementSyncController extends SysOperationServiceController
{
    /// <summary>
    /// Wires the controller to the service operation and sets the dialog caption.
    /// </summary>
    protected void new()
    {
        super();
        this.parmClassName(classStr(LcProcurementSyncService));
        this.parmMethodName(methodStr(LcProcurementSyncService, run));
        this.parmDialogCaption("Launch Control procurement sync");
    }

    /// <summary>
    /// Standard SysOperation construct helper.
    /// </summary>
    public static LcProcurementSyncController construct()
    {
        return new LcProcurementSyncController();
    }

    /// <summary>
    /// Menu-item / job entry point. Opens the batch dialog; the operator can run
    /// interactively or schedule it as a recurring batch job.
    /// </summary>
    /// <param name = "_args">Standard menu-item arguments.</param>
    public static void main(Args _args)
    {
        LcProcurementSyncController controller = LcProcurementSyncController::construct();
        controller.parmShowDialog(true);
        controller.startOperation();
    }
}
